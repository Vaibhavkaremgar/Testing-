# Database Configuration
# Preferred production configuration for MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/talentai
# Or configure discrete values instead of DATABASE_URL:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=talentai

# Security (REQUIRED for production - generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL
FRONTEND_URL=https://dashboard.pontis.one
PUBLIC_BASE_URL=https://pontis.one
UPLOAD_DIR=/data
RESUME_UPLOAD_MAX_BYTES=5242880

# CORS Settings
# Production should explicitly list trusted frontend origins only.
ALLOWED_ORIGINS=https://dashboard.pontis.one,https://ai-recruitment-dashboard-production.up.railway.app,http://localhost:5173,http://localhost:3000

# Optional: allow Railway preview domains like https://<service>.up.railway.app
CORS_ALLOW_RAILWAY_PREVIEWS=false

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_CREDENTIALS_FILE=hr-dashboard-key.json
GOOGLE_SHEET_ID=your-google-sheet-id

# LLM API Keys (Optional)
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
LLM_PROVIDER=groq

# XML feed defaults
JOB_FEED_DEFAULT_STATUS=active
JOB_FEED_PAGE_SIZE=20
JOB_FEED_MAX_PAGE_SIZE=100
