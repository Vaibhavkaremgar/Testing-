# Database Configuration
DATABASE_URL=sqlite:///./talentai.db
# For Railway PostgreSQL: Use the DATABASE_URL from Railway addon
# For Railway SQLite: sqlite:///./app.db (files will be lost on restart)

# Security (REQUIRED for production - generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL
FRONTEND_URL=https://dashboard.pontis.one

# CORS Settings
# Production should explicitly list trusted frontend origins only.
ALLOWED_ORIGINS=https://dashboard.pontis.one,http://localhost:5173,http://localhost:3000

# Optional: allow Railway preview domains like https://<service>.up.railway.app
CORS_ALLOW_RAILWAY_PREVIEWS=false

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_CREDENTIALS_FILE=hr-dashboard-key.json
GOOGLE_SHEET_ID=your-google-sheet-id

# LLM API Keys (Optional)
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
LLM_PROVIDER=groq
